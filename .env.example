# Neon Postgres. Vercel Storage se Neon connect karne par apne aap add hota hai.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# /api/admin/* ko protect karta hai. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Optional: naye table request/order par email alert (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=owner@example.com
NOTIFY_FROM="Brew & Bliss <onboarding@resend.dev>"
